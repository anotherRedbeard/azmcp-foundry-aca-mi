      "x": 461,
      "y": 298,
      "width": 233,
      "height": 228,
      "text": "Requires APIM subscription key\nValidates delegated Foundry JWT:\n- tenant and audience\n- scope: user_impersonation\n- appid/azp: SPA application\n\nInjects fixed agent_reference\nPreserves Authorization",
      "fontSize": 13,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "center",
      "verticalAlign": "top"
    },
