PORT=3000

# Single-page application registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Delegated Microsoft Foundry scope requested by the SPA
FOUNDRY_API_SCOPE=https://ai.azure.com/user_impersonation

# APIM operation that proxies the Microsoft Foundry Responses API
APIM_RESPONSES_URL=https://<your-apim-name>.azure-api.net/<agent-api-path>/responses
APIM_SUBSCRIPTION_KEY=replace-with-an-apim-subscription-key

# Local chat history. Data persists across browser refreshes but resets when
# the local FastAPI process restarts.
CHAT_HISTORY_BACKEND=memory
AZURE_HOSTED=false

# To test against Azure Cosmos DB instead, set CHAT_HISTORY_BACKEND=cosmos,
# authenticate with az login, and uncomment these values.
# COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
# COSMOS_DATABASE_NAME=chat-history
# COSMOS_CONTAINER_NAME=conversations
