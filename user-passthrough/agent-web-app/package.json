{
  "name": "foundry-agent-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "esbuild client/app.js --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js",
    "build": "npm run build:client",
    "dev:client": "esbuild client/app.js --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js --watch",
    "check": "npm run build:client && node --check public/app.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0",
    "esbuild": "^0.25.0"
  }
}
