    {
      "id": "text-15",
      "type": "text",
      "x": 461,
      "y": 298,
      "width": 233,
      "height": 228,
      "text": "Requires APIM subscription key\nValidates delegated API JWT:\n- tenant and API audience\n- scope: access_as_user\n- azp: SPA application\n\nInjects fixed agent_reference\nReplaces Authorization with APIM MI",
      "fontSize": 13,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "center",
      "verticalAlign": "top",
      "originalText": "Requires APIM subscription key\nValidates delegated API JWT:\n- tenant and API audience\n- scope: access_as_user\n- azp: SPA application\n\nInjects fixed agent_reference\nReplaces Authorization with APIM MI"
    },
