<policies>
  <inbound>
    <base />
    <cors allow-credentials="false">
      <allowed-origins>__ALLOWED_ORIGINS__</allowed-origins>
      <allowed-methods>
        <method>POST</method>
        <method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>authorization</header>
        <header>content-type</header>
        <header>ocp-apim-subscription-key</header>
      </allowed-headers>
    </cors>
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Invalid delegated application token" require-expiration-time="true" require-scheme="Bearer">
      <openid-config url="https://login.microsoftonline.com/__TENANT_ID__/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>api://__RESPONSES_API_CLIENT_ID__</audience>
        <audience>__RESPONSES_API_CLIENT_ID__</audience>
      </audiences>
      <required-claims>
        <claim name="scp" match="any" separator=" ">
          <value>access_as_user</value>
        </claim>
        <claim name="azp" match="any">
          <value>__SPA_CLIENT_ID__</value>
        </claim>
      </required-claims>
    </validate-jwt>
    <set-body>@{
      var body = context.Request.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);
      body[&quot;agent_reference&quot;] = new Newtonsoft.Json.Linq.JObject
      {
        [&quot;type&quot;] = &quot;agent_reference&quot;,
        [&quot;name&quot;] = &quot;MyMCPAgentDemo&quot;
      };
      body.Remove(&quot;agent&quot;);
      return body.ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
    <set-header name="Accept" exists-action="override">
      <value>application/json, text/event-stream</value>
    </set-header>
    <set-backend-service backend-id="foundry-responses" />
    <authentication-managed-identity resource="https://ai.azure.com" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
